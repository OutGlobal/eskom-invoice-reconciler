# ==============================================================================
# ENERA ESKOM BILL BALANCER PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local for local development.
# WARNING: NEVER commit real secret values, passwords, or service role keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (SAFE FOR FRONTEND BROWSER EXPOSURE)
# Note: In Vite, variables prefixed with VITE_ are statically bundled into client JS.
# Never place database passwords, service role keys, or private API tokens here!
# ------------------------------------------------------------------------------

# Public Supabase URL (Used by client-side browser SDK)
VITE_SUPABASE_URL=

# Public Anon / Publishable Key (Protected by PostgreSQL Row Level Security)
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Application & Deployment Metadata
VITE_APP_NAME=
VITE_APP_URL=
VITE_APP_VERSION=
VITE_ORGANISATION_DEFAULT_ID=

# NERSA Megaflex & Reconciliation Tolerance Thresholds
VITE_VARIANCE_TOLERANCE_ZAR=
VITE_VARIANCE_TOLERANCE_PCT=
VITE_POWER_FACTOR_THRESHOLD=
VITE_OCR_CONFIDENCE_THRESHOLD=
VITE_NMD_THRESHOLD_PCT=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE & RUNTIME CONFIGURATION (SAFE / NON-SECRET CONFIGURATION)
# ------------------------------------------------------------------------------
NODE_ENV=
PORT=
LOG_LEVEL=
AUDIT_LOG_RETENTION_YEARS=
ALLOWED_ORIGINS=
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Supabase Server Endpoints & Public Metadata
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Storage Bucket Names & Upload Constraints
SUPABASE_STORAGE_BUCKET_INVOICES=
SUPABASE_STORAGE_BUCKET_TELEMETRY=
SUPABASE_STORAGE_BUCKET_DISPUTE_PACKS=
SUPABASE_MAX_FILE_SIZE_BYTES=

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE SECRETS & CREDENTIALS (STRICTLY FORBIDDEN FROM FRONTEND EXPOSURE)
# CRITICAL SECURITY EMBARGO:
# - NEVER prefix these with VITE_ or PUBLIC_
# - NEVER expose these to the browser client bundle
# - NEVER commit real values to version control
# - Manage these exclusively in production vault or hosting environment secrets
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Elevated privileges, bypasses Row-Level Security)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Direct PostgreSQL Connection URL (Contains database credentials & password)
DATABASE_URL=

# Cryptographic Master Secrets & Keys
JWT_SECRET=
ENCRYPTION_KEY_256=

# Monitoring & Alert Endpoints
ALERT_WEBHOOK_URL=
SENTRY_DSN=

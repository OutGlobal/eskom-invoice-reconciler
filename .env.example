# ==============================================================================
# ESKOM BILL BALANCER PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in your production deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT IDENTIFIERS
# ------------------------------------------------------------------------------
NODE_ENV=production
VITE_APP_NAME="Eskom Bill Balancer Enterprise"
VITE_APP_URL="https://reconciler.eskom.co.za"
VITE_APP_VERSION="2.1.0-nersa2026"
VITE_ORGANISATION_DEFAULT_ID="org-001"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & API CONFIGURATION
# ------------------------------------------------------------------------------
# Public Supabase URL (Used by client-side browser SDK)
VITE_SUPABASE_URL="https://bramhseicmakyihvnvpo.supabase.co"

# Public Anon Key (Safe for browser client bundle; restricted by Supabase RLS)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJyYW1oc2VpY21ha3lpaHZudnBvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDEyMzg0MjAsImV4cCI6MjA1NjgxNDQyMH0.example_anon_key"

# Server-Side Service Role Key (CRITICAL: NEVER expose to browser bundle or public repositories!)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJyYW1oc2VpY21ha3lpaHZudnBvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc0MTIzODQyMCwiZXhwIjoyMDU2ODE0NDIwfQ.example_service_role_key"

# Database Connection String for Direct DDL Migrations (Transaction pooler port 6543)
DATABASE_URL="postgres://postgres.bramhseicmakyihvnvpo:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ------------------------------------------------------------------------------
# 3. STORAGE BUCKET CONFIGURATION
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_INVOICES="invoices"
SUPABASE_STORAGE_BUCKET_TELEMETRY="amr-telemetry"
SUPABASE_STORAGE_BUCKET_DISPUTE_PACKS="dispute-packs"
SUPABASE_MAX_FILE_SIZE_BYTES=104857600 # 100 MB max per upload file

# ------------------------------------------------------------------------------
# 4. RECONCILIATION & TOLERANCE DEFAULTS
# ------------------------------------------------------------------------------
VITE_VARIANCE_TOLERANCE_ZAR=1000.00
VITE_VARIANCE_TOLERANCE_PCT=1.0
VITE_POWER_FACTOR_THRESHOLD=0.96
VITE_OCR_CONFIDENCE_THRESHOLD=85.0
VITE_NMD_THRESHOLD_PCT=100.0

# ------------------------------------------------------------------------------
# 5. SECURITY, CORS & RATE LIMITING
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="https://reconciler.eskom.co.za,https://app.reconciler.co.za"
RATE_LIMIT_REQUESTS_PER_MINUTE=120
JWT_SECRET="super-secret-jwt-key-replace-in-production-vault"
ENCRYPTION_KEY_256="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 6. MONITORING, LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
SENTRY_DSN="https://example_sentry_key@o4500000000000000.ingest.sentry.io/4500000000000000"
LOG_LEVEL="info"
AUDIT_LOG_RETENTION_YEARS=7
ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/XXXX"
